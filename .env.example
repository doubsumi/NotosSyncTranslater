# ------------------------------------------------------------------
# Environment overrides for the Notos Sync Translator backend.
# Copy to `.env` or export in the shell; all keys are optional.
# ------------------------------------------------------------------

# Bind host / port
NST_HOST=127.0.0.1
NST_PORT=5000

# Upstream free-translation providers, in preference order.
# Tried in order with automatic failover + circuit breaker.
NST_PROVIDERS=bing,alibaba,sogou

# CORS origins for the Vite dev server (comma separated).
# Production serves the SPA from the same origin -> not needed.
NST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Translation-memory cache
NST_CACHE_TTL=86400          # seconds (24 h)
NST_CACHE_MAX=8192           # in-memory entries
# NST_CACHE_DB=./backend/.cache/tm.sqlite3   # optional persistent layer

# Longest single chunk sent to an upstream provider (no input length limit —
# longer text is split at sentence boundaries automatically).
NST_CHUNK_MAX_CHARS=1600

# Rate limiting (per IP token bucket) protecting the free upstreams.
NST_RATE_LIMIT_PER_MIN=240
NST_RATE_LIMIT_BURST=30

# Provider engine tuning
NST_PROVIDER_TIMEOUT=12
NST_PROVIDER_PACING=0.4      # min gap between calls to the same provider (s)
NST_PROVIDER_WORKERS=3       # concurrent upstream calls
NST_PROVIDER_FAIL_THRESHOLD=2
NST_PROVIDER_COOLDOWN=60     # seconds

# Where the built frontend lives (auto-detected when inside this repo).
# NST_STATIC_DIR=/srv/frontend/dist

# Logging
NST_LOG_LEVEL=INFO
